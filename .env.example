# --- Адрес сервера ---
# Хостнейм, который резолвится в IP твоего VPS.
# Без собственного домена используй бесплатный wildcard-DNS:
#   sslip.io   →  если IP 203.0.113.42, хостнейм: 203-0-113-42.sslip.io
#   nip.io     →  если IP 203.0.113.42, хостнейм: 203.0.113.42.nip.io
# Или зарегистрируй бесплатный поддомен на duckdns.org.
SITE_HOSTNAME=YOUR-IP-HERE.sslip.io

# Email для Let's Encrypt (на него придут уведомления, если сертификат не продлился).
LETSENCRYPT_EMAIL=you@example.com

# --- Порты ---
# По умолчанию 80/443. Меняй ТОЛЬКО если они заняты другим сервисом.
# Если поменяешь HTTPS_PORT, мобильный Mattermost подключится по
# https://<host>:<port>, и Let's Encrypt не сможет выпустить серт по HTTP-01
# (нужен публичный 80). Тогда используй DNS-01 или ставь свой домен за CDN.
HTTP_PORT=80
HTTPS_PORT=443

# --- База данных PostgreSQL ---
POSTGRES_USER=mmuser
# Сгенерируй: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=mattermost
